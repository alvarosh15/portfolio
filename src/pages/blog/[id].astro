---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Park from "../../components/Park.astro";
import Footer from "../../components/Footer.astro";
import { formatDate, getPosts } from "../../data/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const link =
  "text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink";
---

<Layout
  title={`${post.data.title} · Alvaro Sanchez`}
  description={post.data.description}
  published={post.data.date}
>
  <Park mode="reading">
    <a href="/" class="text-sm font-medium">Alvaro Sanchez</a>
    <h1 class="mt-6 text-xl leading-relaxed font-medium text-pretty sm:text-2xl sm:leading-relaxed">
      {post.data.title}
    </h1>
    <p class="mt-2 text-xl leading-relaxed text-pretty text-muted sm:text-2xl sm:leading-relaxed">
      {post.data.description}
    </p>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <li>
        <time datetime={post.data.date.toISOString()} class="text-muted">{formatDate(post.data.date)}</time>
      </li>
      <li><a href="/blog/" class={link}>All posts</a></li>
    </ul>
  </Park>

  <!-- Same width and position as the header's middle column. -->
  <main class="mx-auto w-full max-w-[calc(42rem+3rem)] px-6 pb-16">
    <article class="post">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
