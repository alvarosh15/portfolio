---
import Layout from "../layouts/Layout.astro";
import Park from "../components/Park.astro";

const link =
  "underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink";
---

<Layout title="Not found · Alvaro Sanchez" description="This page doesn't exist.">
  <Park mode="lost">
    <a href="/" class="text-sm font-medium">Alvaro Sanchez</a>
    <h1 class="mt-6 text-xl leading-relaxed text-pretty sm:text-2xl sm:leading-relaxed">
      404. <span class="text-muted">This page wandered off, and the park is looking for it.</span>
    </h1>
    <div class="mt-8 font-mono text-sm leading-7 break-all">
      <p><span class="text-ink">$</span> cd <span data-path>/this-page</span></p>
      <p class="text-muted">cd: no such file or directory: <span data-path>/this-page</span></p>
      <p><span class="text-ink">$</span> ls</p>
      <p class="flex gap-6 text-muted">
        <a href="/" class={link}>home</a>
        <a href="/blog/" class={link}>writing</a>
      </p>
      <p>
        <span class="text-ink">$</span>{" "}
        <span class="cursor inline-block h-[1.1em] w-[0.6em] translate-y-[0.2em] bg-ink"></span>
      </p>
    </div>
  </Park>
</Layout>

<style>
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>

<script>
  // The path someone tried to open, shown in the terminal.
  document.addEventListener("astro:page-load", () => {
    for (const el of document.querySelectorAll("[data-path]")) el.textContent = decodeURI(location.pathname);
  });
</script>
