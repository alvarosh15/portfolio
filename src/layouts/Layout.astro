---
import Header from "../components/Header.astro";
import CursorIcons from "../components/CursorIcons.astro";
import "../styles/global.css";
import "@fontsource-variable/onest";
import "@fontsource-variable/playfair-display";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Portfolio of Alvaro Sanchez, a software engineer focused on full-stack development, artificial intelligence, and security-oriented projects.",
  image = "/projects/malwareai.png",
} = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const socialImageUrl = Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>

  <body>
    <div
      class="cursor rounded-full flex items-center justify-center gap-1 transition-[width,height,padding] duration-150 text-white"
      id="cursor"
    >
      <span
        id="cursor-icon"
        class="flex items-center opacity-0 transition-opacity duration-150"
      ></span>
      <span
        id="cursor-text"
        class="opacity-0 text-white transition-opacity duration-150 whitespace-nowrap"
      ></span>
    </div>

    <CursorIcons />

    <Header />
    <slot />
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light;
    --cursor-size: 18px;
  }
  html {
    font-family:
      "Playfair Display Variable", "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    cursor: none;
  }

  a,
  button {
    cursor: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #ec735b;
    outline-offset: 4px;
    border-radius: 9999px;
  }

  .cursor {
    position: fixed;
    pointer-events: none;
    background-color: #ec735b;
    z-index: 1000;
    width: var(--cursor-size);
    height: var(--cursor-size);
    padding: 0;
    opacity: 0;
  }

  @media (pointer: coarse) {
    body,
    a,
    button {
      cursor: auto;
    }
    .cursor {
      display: none;
    }
  }
</style>
<script>
  const cursor = document.getElementById("cursor");
  const cursorIcon = document.getElementById("cursor-icon");
  const cursorText = document.getElementById("cursor-text");
  const CURSOR_SIZE = parseInt(
    getComputedStyle(document.documentElement).getPropertyValue(
      "--cursor-size",
    ),
  );
  const CURSOR_HALF = CURSOR_SIZE / 2;
  const CURSOR_PADDING_Y = CURSOR_SIZE * 0.5;
  const CURSOR_PADDING_X = CURSOR_SIZE;

  document.addEventListener("mousemove", (e) => {
    if (cursor) {
      cursor.style.opacity = "1";
      cursor.style.transform = `translate(${e.clientX - CURSOR_HALF}px, ${e.clientY - CURSOR_HALF}px)`;
    }
  });

  document.addEventListener("mouseleave", () => {
    if (cursor) {
      cursor.style.opacity = "0";
    }
  });

  document.addEventListener("mouseenter", (e) => {
    if (cursor) {
      cursor.style.transform = `translate(${e.clientX - CURSOR_HALF}px, ${e.clientY - CURSOR_HALF}px)`;
      cursor.style.opacity = "1";
    }
  });

  document.addEventListener("mouseover", (e) => {
    if (!(e.target instanceof Element)) return;

    const target = e.target.closest("[data-cursor-text]");
    if (target && cursor && cursorText && cursorIcon) {
      const el = target as HTMLElement;
      cursorText.textContent = el.dataset.cursorText ?? "";
      cursorText.classList.add("opacity-100");

      const iconName = el.dataset.cursorIcon;
      if (iconName) {
        const iconSvg = document.querySelector(
          `#cursor-icons [data-icon="${iconName}"]`,
        );
        if (iconSvg) {
          cursorIcon.appendChild(iconSvg.cloneNode(true));
          cursorIcon.classList.add("opacity-100");
        }
      }

      cursor.style.width = "auto";
      cursor.style.height = "auto";
      cursor.style.padding = `${CURSOR_PADDING_Y}px ${CURSOR_PADDING_X}px`;
    }
  });

  document.addEventListener("mouseout", (e) => {
    if (!(e.target instanceof Element)) return;

    const target = e.target.closest("[data-cursor-text]");
    if (target && cursor && cursorText && cursorIcon) {
      cursor.style.width = `${CURSOR_SIZE}px`;
      cursor.style.height = `${CURSOR_SIZE}px`;
      cursor.style.padding = "0";
      cursorText.textContent = "";
      cursorText.classList.remove("opacity-100");
      cursorIcon.innerHTML = "";
      cursorIcon.classList.remove("opacity-100");
    }
  });
</script>
