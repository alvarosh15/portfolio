---
import "@fontsource-variable/onest";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import defaultImage from "../assets/og.png";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Posts: shared as an article, with this publish date. */
  published?: Date;
}

const {
  title,
  description = "Portfolio of Alvaro Sanchez, a software engineer focused on full-stack development, artificial intelligence, and security.",
  image = defaultImage.src,
  published,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const socialImageUrl = Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Alvaro Sanchez" href="/rss.xml" />
    <meta property="og:site_name" content="Alvaro Sanchez" />
    <meta property="og:type" content={published ? "article" : "website"} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alvaro Sanchez's homepage: a short bio between two pixel art parks" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alvarombt" />
    <meta name="twitter:creator" content="@alvarombt" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <!-- Navigate without full reloads so the park and footer persist between pages. -->
    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
    <slot />
    <Analytics />
  </body>
</html>
