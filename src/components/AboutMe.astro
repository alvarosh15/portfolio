---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---

<Section id="experience" class="py-8">
  <h2 class="text-3xl pb-4">About Me</h2>
  <ol class="relative border-s border-gray-200 dark:border-gray-700">
    {
      experience.map((item) => (
        <li class="mb-10 ms-4 last:mb-0">
          <div class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700" />
          <time class="mb-1 text-sm font-normal leading-none text-gray-500 dark:text-gray-400">
            {item.date}
          </time>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {item.title}
          </h3>
          {"description" in item && (
            <p class="mb-4 text-base font-normal text-gray-600 dark:text-gray-400">
              {item.description}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</Section>
