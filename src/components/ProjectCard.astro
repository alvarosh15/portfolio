---
import { CursorIcon } from "../constants/cursor-icons";

interface Props {
  title: string;
  description: string;
  link?: string;
  github?: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
}

const {
  title,
  description,
  link,
  github,
  image,
  imageWidth,
  imageHeight,
} = Astro.props;
---

<article
  class="flex flex-col group overflow-hidden rounded-2xl bg-[#f4f0e7] p-4 gap-y-3"
>
  <h3 class="text-2xl sm:text-3xl">{title}</h3>
  <p class="text-lg sm:text-xl text-[#a69b85]">
    {description}
  </p>
  <div class="flex flex-wrap gap-3">
    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#a69b85] border-[#a69b85] size-fit rounded-full border text-lg sm:text-xl py-2 px-4
  hover:text-[#f4f0e7] hover:border-[#f4f0e7] hover:bg-[#a69b85]"
          data-cursor-text="View Code"
          data-cursor-icon={CursorIcon.Github}
          aria-label={`View ${title} source code on GitHub`}
        >
          GitHub
        </a>
      )
    }
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#a69b85] border-[#a69b85] size-fit rounded-full border text-lg sm:text-xl py-2 px-4
    hover:text-[#f4f0e7] hover:border-[#f4f0e7] hover:bg-[#a69b85]"
          data-cursor-text="Visit Project"
          data-cursor-icon={CursorIcon.External}
          aria-label={`Visit ${title}`}
        >
          Visit →
        </a>
      )
    }
  </div>
  <img
    src={image}
    alt=`${title} screenshot`
    width={imageWidth}
    height={imageHeight}
    loading="lazy"
    decoding="async"
    class="w-full aspect-[16/10] object-cover rounded-2xl"
  />
</article>
