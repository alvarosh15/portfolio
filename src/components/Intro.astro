---
import SocialPill from "../components/SocialPill.astro";
import { CursorIcon } from "../constants/cursor-icons";
import LinkedIn from "../components/icons/LinkedIn.astro";
import Section from "../components/Section.astro";
import GitHub from "../components/icons/GitHub.astro";
import Mail from "../components/icons/Mail.astro";
import X from "../components/icons/X.astro";
---

<Section class="pt-10 pb-6">
  <h1 class="text-4xl sm:text-5xl pb-4">
    Hey, I'm Alvaro
  </h1>
  <p class="text-xl sm:text-2xl opacity-80 text-wrap pb-4">
    A software engineer with a passion for <span>learning and creating</span>,
    with a special love for full-stack development and AI. I’m always looking
    for new challenges and opportunities to learn and grow.
  </p>

  <nav class="flex flex-wrap gap-2" aria-label="Social links">
    <SocialPill
      href="https://www.linkedin.com/in/alvaro-sanchez-hernandez/"
      aria-label="View LinkedIn profile"
      data-cursor-text="View LinkedIn"
      data-cursor-icon={CursorIcon.LinkedIn}
    >
      <LinkedIn />
    </SocialPill>
    <SocialPill
      href="https://github.com/alvarosh15"
      aria-label="View GitHub profile"
      data-cursor-text="View GitHub"
      data-cursor-icon={CursorIcon.Github}
    >
      <GitHub />
    </SocialPill>
    <SocialPill
      href="https://x.com/alvarombt"
      aria-label="View X profile"
      data-cursor-text="View X"
      data-cursor-icon={CursorIcon.X}
    >
      <X />
    </SocialPill>
    <SocialPill
      href="mailto:alvaro.s.h.15@gmail.com"
      aria-label="Send email to Alvaro"
      data-cursor-text="Send Email"
      data-cursor-icon={CursorIcon.Mail}
    >
      <Mail />
      alvaro.s.h.15@gmail.com
    </SocialPill>
  </nav>
</Section>
